{
  "name": "句间 · GitHub 私有测试",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "句间（保持 Private）",
      "onAutoForward": "notify"
    }
